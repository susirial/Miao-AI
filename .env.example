# Optional. Override the local data directory (SQLite, media, agent snapshots).
# Default (web): ./.data
# Default (macOS desktop): ~/Library/Application Support/Miao/data
# MIAO_DATA_DIR=

# Desktop dev: URL of the Nuxt dev server. `pnpm desktop:dev` sets this automatically.
# MIAO_ELECTRON_DEV_URL=http://localhost:3001

# Optional public site URL when deploying the web UI behind a reverse proxy.
# NUXT_PUBLIC_SITE_URL=http://localhost:3001
# NUXT_SITE_URL=http://localhost:3001

# macOS notarization for `pnpm desktop:build`. Never commit real values.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Provider API keys are entered in the in-app Service connection dialog and stored
# in the local SQLite database. Do not put keys in this file.
