{
  "name": "miao",
  "type": "module",
  "version": "1.0.2",
  "packageManager": "pnpm@10.10.0",
  "description": "China-native multimodal AI agent: DeepSeek, GLM, Doubao, Seedream and Seedance on an infinite canvas. Desktop and web.",
  "author": "susirial",
  "license": "MIT",
  "homepage": "https://github.com/susirial/Miao-AI",
  "bugs": {
    "url": "https://github.com/susirial/Miao-AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susirial/Miao-AI.git"
  },
  "keywords": [
    "ai",
    "agent",
    "creative-workspace",
    "image-generation",
    "video-generation",
    "infinite-canvas",
    "deepseek",
    "glm",
    "seedream",
    "seedance",
    "doubao",
    "volcengine",
    "electron",
    "sqlite",
    "nuxt",
    "vue"
  ],
  "main": "electron/main.mjs",
  "files": [
    "app.vue",
    "components",
    "components.json",
    "composables",
    "constants",
    "layouts",
    "lib",
    "nuxt.config.ts",
    "pages",
    "types"
  ],
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "release": "release-it",
    "test:electron-risk": "pnpm build && electron scripts/electron-risk-spike.mjs",
    "test:electron-main": "node --test scripts/test-electron-main.mjs",
    "desktop:dev": "concurrently --kill-others --success first \"pnpm dev\" \"wait-on http-get://localhost:3001/api/agent/health && MIAO_ELECTRON_DEV_URL=http://localhost:3001 electron .\"",
    "desktop:dir": "pnpm build && electron-builder --mac dir",
    "desktop:build": "pnpm build && electron-builder --mac",
    "test:sqlite": "node --experimental-transform-types --test scripts/test-sqlite.mjs scripts/test-data-paths.mjs scripts/test-agent-history.mjs scripts/test-agent-media-routing.mjs scripts/test-agent-optimistic.mjs scripts/test-agent-generation-state.mjs scripts/test-agent-session-delete.mjs scripts/test-agent-tool-transcript.mjs scripts/test-canvas-bulk.mjs scripts/test-local-data-migration.mjs scripts/test-local-generation-queue.mjs scripts/test-service-settings.mjs scripts/test-media-backend-registry.mjs scripts/test-ark-image-backend.mjs scripts/test-ark-video-backend.mjs scripts/test-agent-results-upsert.mjs scripts/test-generation-result-urls.mjs scripts/test-project-delete.mjs",
    "test:media": "node --experimental-transform-types --test scripts/test-local-media.mjs scripts/test-agent-upload.mjs scripts/test-media-export.mjs scripts/test-reveal-local-media.mjs"
  },
  "build": {
    "appId": "ai.miao.desktop",
    "productName": "Miao",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "electron/nitro-child.mjs"
    ],
    "compression": "normal",
    "npmRebuild": false,
    "afterSign": "electron/notarize.mjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.68",
    "@iconify-json/radix-icons": "^1.2.5",
    "@internationalized/date": "^3.10.0",
    "@number-flow/vue": "^0.4.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "@volcengine/tos-sdk": "^2.9.1",
    "ajv": "^8.20.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "fflate": "^0.8.3",
    "isomorphic-dompurify": "^4.1.0",
    "marked": "^18.0.11",
    "mingo": "^7.2.4",
    "nanoid": "^5.1.6",
    "reka-ui": "^2.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.2",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@electron/notarize": "^3.1.1",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/i18n": "^10.0.6",
    "@pinia/nuxt": "^0.5.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^12.8.2",
    "@vueuse/math": "^12.8.2",
    "@vueuse/nuxt": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.1.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.37.0",
    "eslint-plugin-format": "^1.0.2",
    "lucide-vue-next": "^0.482.0",
    "nuxt": "^4.1.3",
    "release-it": "^19.0.5",
    "shadcn-nuxt": "2.3.1",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.9.3",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.1.0",
    "zod": "^3.25.76"
  }
}
